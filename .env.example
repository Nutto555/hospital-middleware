PORT=8080
DATABASE_URL=postgres://hospital:hospital@localhost:5433/hospital?sslmode=disable
JWT_SECRET=change-me
JWT_TTL=24h
HOSPITAL_A_BASE_URL=http://localhost:8081
HIS_TIMEOUT=5s
